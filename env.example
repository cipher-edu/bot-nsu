# Telegram Bot Token (BotFather dan olingan)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Admin user IDs (vergul bilan ajratilgan)
# O'z Telegram ID ingizni @userinfobot dan bilib oling
ADMIN_IDS=123456789,987654321

# Database settings - use separate variables for username/password and construct DATABASE_URL
# Recommended: create a .env file with the following values
DB_USER=botuser
DB_PASSWORD=secure_password_change_me
DB_NAME=telegram_bot
DB_HOST=postgres
DB_PORT=5432

# Full DATABASE_URL will be constructed in docker-compose or by the app from the above values
# Example (auto-generated):
# DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
